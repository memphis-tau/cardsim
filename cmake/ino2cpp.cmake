# Joins a sketch's .ino tabs into one C++ file, the way the Arduino IDE does
# (main tab first, then the others alphabetically). Called at build time.
#   cmake -DOUT=file.cpp -DMAIN=main.ino "-DTABS=a.ino;b.ino" -P ino2cpp.cmake
file(WRITE "${OUT}.tmp" "// Generated by CardSim from ${MAIN}. Edit the .ino, not this file.\n#include <Arduino.h>\n")
set(ALL "${MAIN}")
foreach(T ${TABS})
  if(NOT T STREQUAL MAIN)
    list(APPEND ALL "${T}")
  endif()
endforeach()
foreach(F ${ALL})
  file(READ "${F}" BODY)
  file(APPEND "${OUT}.tmp" "#line 1 \"${F}\"\n${BODY}\n")
endforeach()
# Only touch the output if it changed, so builds stay incremental.
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
